# Wspólne
NODE_ENV=development

# --- Postgres (atomy) — uzupełnij lokalnie w `.env` ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_DB_TEST=
POSTGRES_HOST=
POSTGRES_PORT=

# E2E (efemeryczny compose `docker-compose.e2e.yml` / `pnpm test:e2e`)
E2E_POSTGRES_HOST=
E2E_POSTGRES_PORT=
# Opcjonalny override pełnym URL (wygrywa nad atomami dla e2e):
# E2E_DATABASE_URL=
# E2E_DATABASE_URL_TEST=

# Pełne URL-e ścieżki A / host (gdy ustawione — wygrywają nad składaniem z atomów).
# Host path (pnpm db:up + pnpm dev:*): zwykle localhost + POSTGRES_PORT
# Compose.dev (pnpm dev:stack:up): compose nadpisuje hostem usługi `postgres`
DATABASE_URL=
DATABASE_URL_TEST=

# api
API_PORT=3001
LOG_LEVEL=debug

JWT_SECRET=change-me-dev-jwt-secret-min-32-chars!!
COOKIE_SECURE=false

# worker
WORKER_LOG_LEVEL=debug
LLM_MOCK_MODE=happy
