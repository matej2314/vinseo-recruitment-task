# Wspólne
NODE_ENV=development

# Host path (pnpm db:up + pnpm dev:*): localhost
# Compose.dev (pnpm dev:stack:up): compose nadpisuje hostem usługi `postgres` — nie trzeba zmieniać .env ręcznie
DATABASE_URL=
DATABASE_URL_TEST=

# api
API_PORT=3001
LOG_LEVEL=debug

JWT_SECRET=change-me-dev-jwt-secret-min-32-chars!!
COOKIE_SECURE=false

# worker
WORKER_LOG_LEVEL=debug
LLM_MOCK_MODE=happy
