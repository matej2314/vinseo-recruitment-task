generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  employee
  admin
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

/// Wynik powiązania spotkania z Client (matching domeny e-mail zewnętrznego).
enum ClientLinkStatus {
  internal
  matched
  unmatched
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         UserRole @default(employee)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        ProjectMembership[]
  participants       MeetingParticipant[]
  organizedMeetings  Meeting[]            @relation("MeetingOrganizer")
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  /// Domena e-mail do matchingu (bez HubSpot); unikalna.
  emailDomain String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
  meetings    Meeting[]
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client              @relation(fields: [clientId], references: [id])
  memberships ProjectMembership[]
  meetings    Meeting[]
}

/// Pod przyszłą fazę ACL zespołu klienta — nie egzekwowane w access v1.
model ProjectMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Meeting {
  id                 String           @id @default(uuid()) @db.Uuid
  externalMeetingId  String           @unique
  title              String?
  organizerId        String?          @db.Uuid
  clientId           String?          @db.Uuid
  projectId          String?          @db.Uuid
  clientLinkStatus   ClientLinkStatus @default(internal)
  confidential       Boolean          @default(false)
  processingStatus   ProcessingStatus @default(pending)
  startedAt          DateTime?
  /// Czas trwania w sekundach — zostaje przy erase treści.
  durationSeconds    Int?
  /// Segmenty transcriptu (JSON) — kasowane przy erase.
  transcriptSegments Json?
  /// Summary kanoniczne: shortSummary, decisions, actionItems (JSON) — kasowane przy erase.
  summary            Json?
  /// Uczestnicy zewnętrzni (e-mail poza domeną firmy) — kasowane przy erase.
  externalParticipants Json?
  failureReason      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organizer    User?                @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  client       Client?              @relation(fields: [clientId], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id])
  participants MeetingParticipant[]

  @@index([organizerId])
  @@index([clientLinkStatus])
}

model MeetingParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  familyId  String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String
  resourceId String?
  userId     String?  @db.Uuid
  requestId  String?
  resultCode String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([eventType, createdAt])
}
