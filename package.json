{
  "name": "vinseo-recruitment-task",
  "version": "1.0.0",
  "private": true,
  "description": "Firmowy asystent spotkań — monorepo (api / worker / web)",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @vinseo/contracts build && pnpm --filter @vinseo/api start:dev",
    "dev:worker": "pnpm --filter @vinseo/contracts build && pnpm --filter @vinseo/worker start:dev",
    "dev:web": "pnpm --filter @vinseo/web dev",
    "dev:stack:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "dev:stack:down": "docker compose -f docker-compose.dev.yml down",
    "dev:stack:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @vinseo/api test && pnpm --filter @vinseo/worker test",
    "test:integration": "pnpm --filter @vinseo/worker test:integration",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:logs": "docker compose -f docker-compose.db.yml logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck:contracts": "pnpm --filter @vinseo/contracts typecheck"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1"
  }
}
