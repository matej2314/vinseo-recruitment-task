{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.jest.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@nestjs/config$": "<rootDir>/nestjs-config-shim.cjs",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
